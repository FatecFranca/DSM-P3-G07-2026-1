        "bcryptjs": "^3.0.3",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1"
    },
    "devDependencies": {
        "prisma": "^6.12.0",
        "nodemon": "^3.1.10",
        "mocha": "^10.2.0",
        "supertest": "^6.3.3"
    }
}