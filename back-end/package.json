{
    "name": "back-end",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nodemon ./src/bin/server.js",
        "start": "node ./src/bin/server.js",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio",
        "test:unit": "node --test --test-concurrency=1",
